---
import HeroBackground from './islands/HeroBackground';
import HeroStats from './HeroStats.astro';
import Notification from './islands/Notification';
---

<!-- HERO -->
<section style="position: relative; overflow: hidden; min-height: 560px;">
  <HeroBackground client:load />
  <Notification client:load />

  <!-- Vignette: bottom fade -->
  <div
    style="position: absolute; inset: 0; pointer-events: none; z-index: 1; background: linear-gradient(to bottom, #111113 0%, transparent 28%, transparent 48%, rgba(17,17,19,0.88) 75%, #111113 100%);"
  >
  </div>
  <!-- Vignette: left fade -->
  <div
    style="position: absolute; inset: 0; pointer-events: none; z-index: 1; background: linear-gradient(to right, #111113 0%, rgba(17,17,19,0.5) 18%, transparent 40%);"
  >
  </div>
  <!-- Vignette: right fade -->
  <div
    style="position: absolute; inset: 0; pointer-events: none; z-index: 1; background: linear-gradient(to left, #111113 0%, transparent 30%);"
  >
  </div>

  <!-- Content -->
  <div
    style="position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 120px 40px 90px;"
  >
    <div class="label mb-5">TypeScript · MIT · Node 20+</div>
    <h1
      class="mb-5 leading-[1.0] font-black tracking-[-0.03em]"
      style="font-size: clamp(40px, 5vw, 58px); max-width: 680px;"
    >
      Build your anime app.
      <br />
      <span class="gradient-text">We'll handle the streams.</span>
    </h1>
    <p class="mb-8 text-[14.5px] leading-[1.75]" style="color: var(--muted); max-width: 460px;">
      A TypeScript SDK for searching anime and manga across 12 sources and resolving direct stream
      URLs. One import, nine methods. Use the SDK directly or run the built-in HTTP server.
    </p>
    <div class="flex items-center gap-4">
      <a
        href="/docs"
        class="bg-white px-5 py-2.5 text-[13px] font-semibold text-black transition-colors hover:bg-zinc-100"
      >
        Get started →
      </a>
      <a
        href="https://github.com/hexxt-git/anime-sdk"
        target="_blank"
        class="text-[13px] font-medium transition-colors hover:text-white"
        style="color: var(--muted);"
      >
        View on GitHub ↗
      </a>
    </div>
  </div>
</section>

<HeroStats />
