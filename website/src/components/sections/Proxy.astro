---
const proxyEnableCode = `<code><span class="cm">// enable /proxy + automatic URL rewriting</span>
<span class="kw">import</span> <span class="pun">{</span> <span class="typ">startServer</span> <span class="pun">}</span> <span class="kw">from</span> <span class="str">'anime-sdk'</span><span class="pun">;</span>
<span class="fn">startServer</span><span class="pun">({</span>
  port<span class="pun">:</span> <span class="num">3030</span><span class="pun">,</span>
  proxy<span class="pun">:</span> <span class="pun">{</span>
    signSecret<span class="pun">:</span> process<span class="pun">.</span>env<span class="pun">.</span><span class="prop">PROXY_SIGN_SECRET</span><span class="pun">,</span>
  <span class="pun">},</span>
<span class="pun">});</span></code>`;

const proxyRewriteCode = `<code><span class="cm">// without proxy</span>
<span class="pun">{</span>
  url<span class="pun">:</span> <span class="str">"https://cdn.example.com/ep1.m3u8"</span><span class="pun">,</span>
  headers<span class="pun">:</span> <span class="pun">{</span> <span class="prop">Referer</span><span class="pun">:</span> <span class="str">"https://provider.com"</span> <span class="pun">},</span>
  origin<span class="pun">:</span> <span class="pun">{</span> host<span class="pun">:</span> <span class="str">"cdn.example.com"</span><span class="pun">,</span> proxied<span class="pun">:</span> <span class="kw">false</span> <span class="pun">}</span>
<span class="pun">}</span>

<span class="cm">// with proxy</span>
<span class="pun">{</span>
  url<span class="pun">:</span> <span class="str">"http://localhost:3030/proxy?url=...&amp;sig=..."</span><span class="pun">,</span>
  origin<span class="pun">:</span> <span class="pun">{</span> host<span class="pun">:</span> <span class="str">"cdn.example.com"</span><span class="pun">,</span> proxied<span class="pun">:</span> <span class="kw">true</span> <span class="pun">}</span>
<span class="pun">}</span></code>`;

const proxyPlayerCode = `<code><span class="cm">// just pass stream.url straight to hls.js</span>
<span class="kw">const</span> hls <span class="pun">=</span> <span class="kw">new</span> <span class="fn">Hls</span><span class="pun">();</span>
hls<span class="pun">.</span><span class="fn">loadSource</span><span class="pun">(</span>stream<span class="pun">.</span>url<span class="pun">);</span>
hls<span class="pun">.</span><span class="fn">attachMedia</span><span class="pun">(</span>videoEl<span class="pun">);</span>

<span class="cm">// stream.origin.host shows the real CDN hostname</span>
<span class="cm">// no xhrSetup. no custom headers needed.</span>
<span class="cm">// segment + key URLs rewrite automatically.</span></code>`;
---

<section id="proxy">
  <div class="hline flex flex-wrap items-start justify-between gap-3 px-10 py-8">
    <div>
      <div class="mb-1 flex items-center gap-3">
        <h2 class="text-[28px] font-bold tracking-tight">Browser-ready streams.</h2>
      </div>
      <p class="text-[14px]" style="color: var(--muted);">
        Most stream CDNs require a <code class="font-mono text-[12px]" style="color: var(--accent);"
          >Referer</code
        > header browsers can't send freely. Enable the proxy and every URL in the response becomes a
        plain proxied URL your player can use directly. <code
          class="font-mono text-[12px]"
          style="color: var(--accent);">stream.origin.host</code
        > always tells you where it really came from.
      </p>
    </div>
  </div>

  <div class="hline grid grid-cols-1 lg:grid-cols-3">
    <div class="cell no-bottom show-dots px-8 py-8">
      <div class="mb-5 flex items-center gap-3">
        <span class="badge badge-ok">Enable it</span>
        <span class="font-mono text-[11px]" style="color: var(--muted);">one option</span>
      </div>
      <pre class="font-mono text-[12px] leading-[1.85] text-zinc-300" set:html={proxyEnableCode} />
      <p class="mt-4 text-[11.5px] leading-relaxed" style="color: var(--muted);">
        A <code class="font-mono" style="color: var(--accent);">/proxy</code> endpoint becomes active
        and every <code class="font-mono" style="color: var(--accent);">url</code> in <code
          class="font-mono"
          style="color: var(--accent);">/episode/:id/stream</code
        > responses is rewritten to go through it.
      </p>
    </div>

    <div class="cell no-bottom show-dots px-8 py-8">
      <div class="mb-5 flex items-center gap-3">
        <span class="badge badge-muted">URLs rewritten automatically</span>
      </div>
      <pre class="font-mono text-[12px] leading-[1.85] text-zinc-300" set:html={proxyRewriteCode} />
      <p class="mt-4 text-[11.5px] leading-relaxed" style="color: var(--muted);">
        Required headers are signed into the URL. Your frontend uses <code
          class="font-mono"
          style="color: var(--accent);">stream.url</code
        > as-is. The origin is always accessible in <code
          class="font-mono"
          style="color: var(--accent);">stream.origin.host</code
        >.
      </p>
    </div>

    <div class="cell no-right no-bottom show-dots px-8 py-8">
      <div class="mb-5 flex items-center gap-3">
        <span class="badge badge-muted">Drop into any player</span>
        <span class="font-mono text-[11px]" style="color: var(--muted);"
          >hls.js / video.js / &lt;video&gt;</span
        >
      </div>
      <pre class="font-mono text-[12px] leading-[1.85] text-zinc-300" set:html={proxyPlayerCode} />
      <p class="mt-4 text-[11.5px] leading-relaxed" style="color: var(--muted);">
        HLS manifest rewriting is recursive: segment URLs, key URLs, and sub-playlist URLs all go
        through the proxy. The header chain propagates automatically.
      </p>
    </div>
  </div>
</section>
