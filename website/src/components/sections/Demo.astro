---
const demoCode = `<code><span class="kw">import</span> <span class="pun">{</span> <span class="typ">createSdk</span> <span class="pun">}</span> <span class="kw">from</span> <span class="str">'anime-sdk'</span><span class="pun">;</span>

<span class="kw">const</span> sdk <span class="pun">=</span> <span class="fn">createSdk</span><span class="pun">();</span> <span class="cm">// zero config</span>

<span class="cm">// search → episodes → stream</span>
<span class="kw">const</span> <span class="pun">[</span>show<span class="pun">]</span>    <span class="pun">=</span> <span class="kw">await</span> sdk<span class="pun">.</span><span class="fn">search</span><span class="pun">(</span><span class="str">'Frieren'</span><span class="pun">,</span> <span class="pun">{</span> kind<span class="pun">:</span> <span class="str">'anime'</span> <span class="pun">});</span>
<span class="kw">const</span> <span class="pun">{</span> items <span class="pun">}</span> <span class="pun">=</span> <span class="kw">await</span> sdk<span class="pun">.</span><span class="fn">episodes</span><span class="pun">(</span>show<span class="pun">);</span>
<span class="kw">const</span> stream   <span class="pun">=</span> <span class="kw">await</span> sdk<span class="pun">.</span><span class="fn">stream</span><span class="pun">(</span>items<span class="pun">[</span><span class="num">0</span><span class="pun">],</span> <span class="pun">{</span> language<span class="pun">:</span> <span class="str">'sub'</span> <span class="pun">});</span>

console<span class="pun">.</span><span class="fn">log</span><span class="pun">(</span>stream<span class="pun">.</span>url<span class="pun">);</span>          <span class="cm">// playable URL</span>
console<span class="pun">.</span><span class="fn">log</span><span class="pun">(</span>stream<span class="pun">.</span>origin<span class="pun">.</span>host<span class="pun">);</span>  <span class="cm">// origin hostname</span>
console<span class="pun">.</span><span class="fn">log</span><span class="pun">(</span>stream<span class="pun">.</span>adjacent<span class="pun">.</span>next<span class="pun">);</span> <span class="cm">// next episode id</span></code>`;
---

<section id="demo">
  <div class="hline px-10 py-8">
    <h2 class="mb-1 text-[28px] font-bold tracking-tight">Setup in minutes.</h2>
    <p class="text-[14px]" style="color: var(--muted);">
      One import. Three calls.{' '}
      <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">search</code>
      {' → '}
      <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">episodes</code>
      {' → '}
      <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">stream</code>
      . All 12 sources behind a single API.
    </p>
  </div>

  <div class="hline md:grid md:grid-cols-2">
    <div class="cell no-bottom show-dots px-10 py-9">
      <div class="mb-5 flex items-center gap-3">
        <span class="badge badge-muted">Install</span>
        <span class="font-mono text-[11px]" style="color: var(--muted);">terminal</span>
      </div>
      <pre
        class="font-mono text-[12px] leading-[1.85] text-zinc-300"><code><span class="cm">$</span> npm install anime-sdk</code></pre>
      <div class="mt-7 mb-5 flex items-center gap-3">
        <span class="badge badge-ok">createSdk</span>
        <span class="font-mono text-[11px]" style="color: var(--muted);">example.ts</span>
      </div>
      <pre class="font-mono text-[12px] leading-[1.85] text-zinc-300" set:html={demoCode} />
      <p class="mt-5 text-[12px]" style="color: var(--muted);">
        Pass{' '}
        <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]"
          >'sub' | 'dub' | 'raw'</code
        >
        {' '}to{' '}
        <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">stream()</code>
        . All types are plain POJOs — safe for React state, Redux, Zustand.
      </p>
    </div>
    <div
      class="cell no-right no-bottom max-md:h-96"
      style="padding:0; position:relative; overflow:hidden;"
    >
      <video
        autoplay
        loop
        controls
        playsinline
        style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center;"
        src="/anime-sdk-test.mp4"></video>
      <a
        href="https://github.com/hexxt-git/anime-sdk/tree/master/examples/website"
        target="_blank"
        rel="noopener noreferrer"
        style="position:absolute; top:12px; right:12px; z-index:10; background:var(--bg); color:var(--muted); font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:600; letter-spacing:0.06em; padding:4px 10px; text-decoration:none; transition:color 0.15s;"
        onmouseover="this.style.color='#fff'"
        onmouseout="this.style.color='var(--muted)'">demo website ↗</a
      >
    </div>
  </div>
</section>
