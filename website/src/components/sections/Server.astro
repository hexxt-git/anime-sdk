---
const serverStartCode = `<code><span class="cm"># zero-install server — all 12 sources, proxy on</span>
<span class="cm">$</span> npx anime-sdk

<span class="cm">// or programmatically:</span>
<span class="kw">import</span> <span class="pun">{</span> <span class="typ">startServerV2</span> <span class="pun">}</span> <span class="kw">from</span> <span class="str">'anime-sdk/server'</span><span class="pun">;</span>
<span class="kw">await</span> <span class="fn">startServerV2</span><span class="pun">({</span> port<span class="pun">:</span> <span class="num">3030</span> <span class="pun">});</span>

<span class="cm">// → http://localhost:3030</span></code>`;

const serverCurlCode = `<code><span class="cm"># search anime or manga</span>
curl <span class="str">'localhost:3030/search?q=Frieren&amp;kind=anime'</span>

<span class="cm"># episodes or chapters</span>
curl <span class="str">'localhost:3030/media/:id/episodes'</span>

<span class="cm"># resolve stream</span>
curl <span class="str">'localhost:3030/episode/:id/stream?language=sub'</span></code>`;

const serverAuthCode = `<code><span class="cm">$</span> PORT<span class="pun">=</span><span class="num">8080</span> \\
  SOURCES_DISABLED<span class="pun">=</span>goyabu \\
  npx anime-sdk

<span class="cm">// all sources, with SDK instance:</span>
<span class="kw">import</span> <span class="pun">{</span> <span class="typ">createSdk</span><span class="pun">,</span> <span class="typ">startServerV2</span> <span class="pun">}</span> <span class="kw">from</span> <span class="str">'anime-sdk'</span><span class="pun">;</span>
<span class="fn">startServerV2</span><span class="pun">({</span> sdk<span class="pun">:</span> <span class="fn">createSdk</span><span class="pun">({</span> cache <span class="pun">})});</span></code>`;
---

<section id="server">
  <div class="hline flex flex-wrap items-start justify-between gap-3 px-10 py-8">
    <div>
      <div class="mb-1 flex items-center gap-3">
        <h2 class="text-[28px] font-bold tracking-tight">Skip the API boilerplate.</h2>
      </div>
      <p class="text-[14px]" style="color: var(--muted);">
        anime-sdk ships with a zero-config HTTP server. One command or one line of code. Routes for
        search, episodes, streams, manga pages, and browse; bring-your-own cache with a two-method
        get/set interface. Point any client at it, ship.
      </p>
    </div>
  </div>

  <div class="hline grid grid-cols-1 lg:grid-cols-3">
    <div class="cell no-bottom show-dots px-8 py-8">
      <div class="mb-5 flex items-center gap-3">
        <span class="badge badge-ok">Start it</span>
        <span class="font-mono text-[11px]" style="color: var(--muted);">terminal / server.ts</span>
      </div>
      <pre class="font-mono text-[12px] leading-[1.85] text-zinc-300" set:html={serverStartCode} />
    </div>

    <div class="cell no-bottom show-dots px-8 py-8">
      <div class="mb-5 flex items-center gap-3">
        <span class="badge badge-muted">Call it from anywhere</span>
        <span class="font-mono text-[11px]" style="color: var(--muted);">curl / fetch / axios</span>
      </div>
      <pre class="font-mono text-[12px] leading-[1.85] text-zinc-300" set:html={serverCurlCode} />
      <p class="mt-4 text-[11.5px] leading-relaxed" style="color: var(--muted);">
        Any client that speaks HTTP: React Native, Swift, Kotlin, Flutter, Python, you name it.
      </p>
    </div>

    <div class="cell no-right no-bottom show-dots px-8 py-8">
      <div class="mb-5 flex items-center gap-3">
        <span class="badge badge-muted">Configure</span>
        <span class="font-mono text-[11px]" style="color: var(--muted);">optional</span>
      </div>
      <pre class="font-mono text-[12px] leading-[1.85] text-zinc-300" set:html={serverAuthCode} />
      <p class="mt-4 text-[11.5px] leading-relaxed" style="color: var(--muted);">
        Skip the server entirely and call the SDK directly. No HTTP required.
      </p>
    </div>
  </div>
</section>
