---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: 'What is the fastest way to get started?',
    a: 'Clone <a href="https://github.com/hexxt-git/anime-sdk/tree/master/examples" target="_blank" class="underline underline-offset-2 transition-colors hover:text-white">github.com/hexxt-git/anime-sdk/tree/master/examples</a>. Build the SDK: <code>npm run build</code>. Start the server: <code>node examples/server.mjs</code>. Run the website: <code>cd examples/website && npm install && npm run dev</code>.',
  },
  {
    q: 'Can I use anime-sdk in a browser app?',
    a: 'No. anime-sdk runs in Node or Bun only. For a browser frontend, run the built-in HTTP server on your backend and call it over HTTP from the client.',
  },
  {
    q: 'I got a stream back from sdk.stream(). How do I play it?',
    a: 'Check stream.isHls. If true, use hls.js on Chrome or Firefox, or a native &lt;video&gt; on Safari. If false, set stream.url directly as the video source. stream.origin.host tells you where it really came from.',
  },
  {
    q: 'Which source gives the best results?',
    a: "createSdk() picks the best available source automatically. If you want to target a specific one, pass sources: ['allmanga'] in the config. AllManga has the widest anime catalogue with sub and dub. AnimeParadise is best for external subtitle tracks. MangaDex is the canonical manga source.",
  },
  {
    q: 'Which sources have dubbed anime?',
    a: "AllManga, Anikoto, and MegaPlay support sub and dub. Goyabu is Brazilian Portuguese dub only. Gogoanime and AnimeParadise are sub-only. Pass language: 'dub' to sdk.stream() — if the source doesn't have dub for that episode, you'll get an error.",
  },
  {
    q: 'Do stream URLs expire?',
    a: 'Yes, usually within minutes. Resolve streams on demand when the user wants to play something — do not cache them. Search results and episode lists are safe to cache; stream URLs are not.',
  },
  {
    q: 'Can I use anime-sdk without TypeScript?',
    a: 'Yes. The package ships as compiled JavaScript with type declarations alongside. Use ESM (import) or CommonJS (require) — TypeScript is not required either way.',
  },
  {
    q: 'Is anime-sdk legal to use?',
    a: 'anime-sdk resolves stream URLs from sites that host content publicly. It does not bypass DRM or crack paywalls. Whether your specific use is legal depends on your jurisdiction and what you are building — a personal tool is a different situation from a public redistribution service.',
  },
  {
    q: 'What happens when a source goes down?',
    a: "The SDK tries the next best available source automatically. If you need to disable a specific source, pass disabled: ['source-id'] to createSdk(). The live E2E tests hit real endpoints and fail the moment an upstream site breaks, which is how we catch when a source needs updating.",
  },
];
---

<Layout
  title="FAQ — anime-sdk"
  description="Frequently asked questions about anime-sdk."
  ogImage="/og/faq.png"
>
  <div class="font-sans text-white">
    <div class="frame faq">
      <Nav />

      <div class="hline px-10 py-8">
        <div class="label mb-3">FAQ</div>
        <h1 class="mb-2 text-[32px] font-bold tracking-tight">Frequently asked questions.</h1>
        <p class="text-[14px]" style="color: var(--muted);">
          Answers to common questions about anime-sdk. Missing something?
          <a
            href="https://github.com/hexxt-git/anime-sdk/issues"
            target="_blank"
            class="underline underline-offset-2 transition-colors hover:text-white"
            >Open an issue.</a
          >
        </p>
      </div>

      {
        faqs.map((faq) => (
          <div class="hline px-10 py-6">
            <div class="mb-2 text-[14px] font-semibold">{faq.q}</div>
            <p
              class="text-[13px] leading-relaxed"
              style="color: var(--muted); max-width: 680px;"
              set:html={faq.a}
            />
          </div>
        ))
      }

      <Footer />
    </div>
  </div>
</Layout>
